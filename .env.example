# Clerk — student sign-in for graded quizzes (optional until Jose creates the app).
# Without these, the book/labs/practice pages still work; /quizzes/take and
# staff author review (/quizzes, /quizzes/q1) show a “not configured”
# message instead of crashing or showing answers.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional hosted-path overrides if you use Clerk’s hosted pages instead:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# MongoDB Atlas — quiz_attempts + canvas_roster + assignment_progress
# + assignment_submissions (server-only; never NEXT_PUBLIC_).
# Ada/Bob can still see A1 URL fields without this (built-in demo match).
# Real students (e.g. chen.rya@northeastern.edu) need this URI and
# MONGODB_DB to be the same Atlas database you imported canvas_roster into.
MONGODB_URI=
MONGODB_DB=web-dev

# Optional comma-separated Canvas student emails for a tiny allowlist while
# testing, in addition to (or before) importing a full roster CSV.
# CANVAS_ROSTER_EMAILS=jane.doe@northeastern.edu,alex.rivera@northeastern.edu
# Staff A1 test rows (ada@ada.com / bob@bob.com) are built into roster
# matching. Optional Atlas seed: `npm run roster:seed-demo` or People →
# Ensure demo students (also upserted on first Ada/Bob A1 visit).

# Staff allowlists for /people, author-review banks (/quizzes, /quizzes/q1),
# and staff attempt review (/quizzes/staff/q1/attempts).
# Comma-separated, case-insensitive. Anyone may Clerk sign-in; these lists
# are the only privilege check. canvas_roster does NOT grant People or
# author-review access.
# If INSTRUCTOR_EMAILS is unset, the app still allows jannunzi@gmail.com.
INSTRUCTOR_EMAILS=jannunzi@gmail.com
# Teaching assistants who may view /people. Empty by default. After a TA
# creates a Clerk account on the live site, add that exact email here
# (Production) and redeploy.
TA_EMAILS=

# Assignment reopen notices. No email provider is installed.
# `log` (default) records the notice on the server. `noop` skips it.
# TODO: set a provider id here after Resend or similar is wired.
# Do not put API keys in this file.
# ASSIGNMENT_NOTIFY_PROVIDER=log

# Optional dummy email used when staff toggle “View as student”. Default:
# demo.student@webdev.local. Never written to canvas_roster.
# IMPERSONATION_STUDENT_EMAIL=demo.student@webdev.local

# Optional. YouTube Data API v3 key for in-app book term pages
# (`/book/terms/[slug]`). Without it, term pages still render the official
# link and a “Search on YouTube” fallback.
# YOUTUBE_API_KEY=

# Server-only xAI key for website Q1–Q6 coding items (never NEXT_PUBLIC_).
# Same name SnapTools uses. Local lenient grading still works without it;
# Grok is a backup for unusual answers. Canvas QTI does not use this.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4-latest

# Optional Amazon Associates tag shared by the book-chapter further-reading
# banner (45s overlay on /book/ch1–ch6) and the /blog sponsored card.
# Defaults to jannunzi04-20 when unset. The two UIs stay separate.
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=jannunzi04-20

# Sibling Express server (PDF: NEXT_PUBLIC_HTTP_SERVER).
# LiveDemos default to this origin if the var is omitted.
NEXT_PUBLIC_HTTP_SERVER=http://localhost:4000
# Optional later (Chapter 5.5): your Render origin, no trailing slash.
# NEXT_PUBLIC_HTTP_SERVER=https://your-webdev-server.onrender.com
# Chapter 6 — set on the Express server (.env there), not required for next build.
# DATABASE_CONNECTION_STRING=mongodb://127.0.0.1:27017/kambaz
# MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/kambaz
